        "Готово! Хорошей игры!"
    ])))
def chill_mode():
    modes = [
        "Режим отдыха активирован! Как ты хочешь отдохнуть? Я могу включить музыку, открыть YouTube или что-то ещё!",
        "Готов к отдыху! ты предпочитаешь музыку, видео или что-то другое? Я могу помочь тебе расслабиться!",
        "Режим отдыха включен! Как ты хочешь провести время? Я могу включить музыку, открыть YouTube или что-то ещё, чтобы ты мог отдохнуть!"
    ]
    asyncio.run(speak(random.choice(modes)))
    
def goodbye():
    asyncio.run(speak(random.choice([
        "Выключаюсь... До скорой встречи!",
        "Пока! Я всегда рядом, если что!",
        "До свидания! Если что — я всегда рядом!"
    ])))
    exit()

print("Астра готова к работе!")
asyncio.run(speak(random.choice([
    "Астра готова к работе!",
    "Приветствую тебя! Чем могу помочь?",
    ])))

while True:
    audio = record_with_vad (max_duration=15, silence_threshold=1.5)
    if len(audio) < SAMPLE_RATE * 1.5:  # меньше 1.5 секунды
        continue

    text = transcribe(audio)
    if not text:
        continue
    
    if any(greet in text.lower() for greet in ["привет", "здравствуй", "добрый день"]):
        greetings()
    
    if any(feel in text.lower() for feel in ["как дела", "как ты", "чувствуешь"]):
        feeling()
    if any(time_q in text.lower() for time_q in ["который час", "сколько времени", "какая дата"]):
        tell_time()
    if any(joke_q in text.lower() for joke_q in ["расскажи шутку", "пошути", "расскажи анекдот"]):
        tell_joke()
    if any(google_q in text.lower() for google_q in ["открой гугл", "запусти гугл", "открой браузер", "запусти браузер", "открой Google", "запусти Google"]):
        open_google()
    if any(game_q in text.lower() for game_q in ["игровой режим", "включи игровой режим", "активируй игровой режим"]):
        game_mode()
    if any(chill_q in text.lower() for chill_q in ["режим отдыха", "включи режим отдыха", "активируй режим отдыха"]):
        chill_mode()
    if any(bye_q in text.lower() for bye_q in ["пока", "до свидания", "выключись"]):
        goodbye()
    else:
        asyncio.run(speak("Команда не распознана."))




